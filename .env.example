# EvoDoc Drug Safety Engine — Environment Configuration
# Copy this file to .env and fill in your values

# Ollama endpoint (default: local)
OLLAMA_URL=http://localhost:11434

# Medical LLM to use via Ollama
# Options: meditron, meditron:7b, openbiollm, biollama
# Recommendation: meditron (PubMed-trained, best drug safety accuracy)
LLM_MODEL=meditron

# LLM request timeout in seconds
LLM_TIMEOUT_SECONDS=20

# Cache TTL in seconds (default: 3600 = 1 hour)
CACHE_TTL_SECONDS=3600
